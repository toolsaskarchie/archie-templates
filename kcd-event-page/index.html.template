<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>${EVENT_NAME}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700&display=swap" rel="stylesheet">
  <style>
    :root { --bg: #010409; --surface: #0d1117; --border: #1e293b; --text: #e2e8f0;
            --muted: #94a3b8; --accent: #2563eb; --accent-soft: #60a5fa; }
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 16px;
           color: var(--text); background-color: var(--bg);
           background-image:
             radial-gradient(ellipse at top, rgba(37,99,235,.18), transparent 60%),
             linear-gradient(rgba(30,41,59,.35) 1px, transparent 1px),
             linear-gradient(90deg, rgba(30,41,59,.35) 1px, transparent 1px);
           background-size: auto, 48px 48px, 48px 48px;
           font: 16px/1.5 -apple-system, system-ui, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; }
    main { width: 100%; max-width: 680px; text-align: center; background: rgba(13,17,23,.85);
           border: 1px solid var(--border); border-radius: 8px; padding: 48px 32px; }
    .city { color: var(--accent-soft); font-weight: 600; font-size: .85rem; letter-spacing: .25em;
            text-transform: uppercase; margin: 0; }
    h1 { font-family: Poppins, system-ui, sans-serif; font-weight: 700; font-size: clamp(2.2rem, 7vw, 3.5rem);
         line-height: 1.1; margin: .35em 0 .45em; }
    .message { font-size: clamp(1.15rem, 3.5vw, 1.6rem); font-weight: 500; margin: 0 0 1.75em; }
    .next { margin: 0; color: var(--muted); }
    .pill { display: inline-block; margin-top: .5em; background: var(--accent); color: #fff; font-weight: 600;
            padding: .45em 1.1em; border-radius: 999px; }
  </style>
</head>
<body>
  <main>
    <p class="city">${CITY}</p>
    <h1>${EVENT_NAME}</h1>
    <p class="message">${MESSAGE}</p>
    <p class="next">Próximo evento<br><span class="pill">${NEXT_EVENT}</span></p>
  </main>
</body>
</html>
